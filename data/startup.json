      "keyActivities": ["产品开发", "用户验证", "市场测试", "商业模式验证"],
      "funding": "种子轮融资",
      "challenges": ["产品开发", "用户获取", "商业模式验证"]
    },
    {
      "id": "stage03",
      "name": "早期阶段",
