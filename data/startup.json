      "challenges": ["规模化管理", "市场竞争", "资金压力"]
    },
    {
      "id": "stage05",
      "name": "成熟阶段",
      "description": "从规模化到盈利/上市",
      "duration": "24个月以上",
      "keyActivities": ["盈利", "上市准备", "国际化", "生态建设"],
      "funding": "D轮/Pre-IPO/上市",
      "challenges": ["盈利压力", "市场竞争", "组织管理"]
    }
  ],
  "businessModels": [
    {
      "id": "model01",
      "name": "SaaS模式",
      "description": "软件即服务，按订阅收费",
      "examples": ["Salesforce", "Zoom", "Slack"],
      "advantages": ["可预测收入", "高毛利", "可扩展"],
      "challenges": ["获客成本高", "客户留存", "竞争激烈"]
    },
    {
      "id": "model02",
      "name": "平台模式",
      "description": "连接供需双方，收取佣金",
      "examples": ["淘宝", "滴滴", "美团"],
      "advantages": ["网络效应", "高壁垒", "可扩展"],
      "challenges": ["鸡生蛋问题", "监管风险", "竞争激烈"]
    },
    {
      "id": "model03",
      "name": "广告模式",
      "description": "通过广告变现",
      "examples": ["Google", "Facebook", "抖音"],
      "advantages": ["用户免费", "规模效应", "数据价值"],
      "challenges": ["用户隐私", "广告体验", "竞争激烈"]
    },
    {
      "id": "model04",
      "name": "交易模式",
      "description": "通过交易抽成变现",
      "examples": ["支付宝", "微信支付", "PayPal"],
      "advantages": ["交易量越大收入越高", "高壁垒", "数据价值"],
      "challenges": ["监管风险", "竞争激烈", "安全风险"]
    },
    {
      "id": "model05",
      "name": "硬件+服务模式",
      "description": "硬件销售+后续服务收费",
      "examples": ["苹果", "特斯拉", "小米"],
      "advantages": ["硬件入口", "服务收入", "用户粘性"],
      "challenges": ["硬件成本", "供应链", "竞争激烈"]
    }
  ],
